<?xml version="1.0" encoding="utf-8"?>
<!-- This machine's user-level NuGet config has no online source; this adds nuget.org for this project only. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
